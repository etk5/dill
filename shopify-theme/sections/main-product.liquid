<section class="commerce-wrap product-layout"><div class="product-gallery">{% for image in product.images %}{% if forloop.first %}{{ image | image_url: width: 1200 | image_tag: widths: '400, 700, 1000, 1200', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'eager' }}{% else %}{{ image | image_url: width: 1200 | image_tag: widths: '400, 700, 1000, 1200', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy' }}{% endif %}{% endfor %}</div><div class="product-info"><h1>{{ product.title | escape }}</h1>
{% form 'product', product %}{{ form.errors | default_errors }}<label for="variant-{{ section.id }}">{{ 'general.variant' | t }}</label><select id="variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money_with_currency }}{% unless variant.available %} — {{ 'general.sold_out' | t }}{% endunless %}</option>{% endfor %}</select>
<label for="quantity-{{ section.id }}">{{ 'general.quantity' | t }}</label><input id="quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" required>
<button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ 'general.add' | t }}{% else %}{{ 'general.sold_out' | t }}{% endif %}</button>{% endform %}<div class="product-description">{{ product.description }}</div></div></section>
{% schema %}
{"name": "Main Product", "settings": []}
{% endschema %}
