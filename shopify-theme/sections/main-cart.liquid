<section class="commerce-wrap"><h1>{{ 'general.cart' | t }}</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" class="cart-form">{% for item in cart.items %}<div class="cart-row">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy' }}{% endif %}<div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p><p>{{ item.final_line_price | money_with_currency }}</p><label for="quantity-{{ forloop.index }}">{{ 'general.quantity' | t }}</label><input id="quantity-{{ forloop.index }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}" required><a href="{{ item.url_to_remove }}">{{ 'general.remove' | t }}</a></div></div>{% endfor %}<p>{{ 'general.subtotal' | t }}: {{ cart.total_price | money_with_currency }}</p><p>{{ 'general.shipping' | t }}</p><div class="cart-actions"><button class="button" type="submit" name="update">{{ 'general.update' | t }}</button><button class="button" type="submit" name="checkout">{{ 'general.checkout' | t }}</button></div></form>{% else %}<p>{{ 'general.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue' | t }}</a>{% endif %}</section>
{% schema %}
{"name": "Main Cart", "settings": []}
{% endschema %}
