<footer class="scallop-footer footer-compact{% if settings.logo != blank %} custom-footer-logo{% endif %}"><div class="footer-side"><a href="{{ routes.root_url }}" class="brand-logo">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 640 | image_tag: loading: 'lazy', alt: shop.name }}{% else %}<img src="{{ 'dillweedlogos_2.png' | asset_url }}" alt="Dillweed &amp; Dirt" width="800" height="533" loading="lazy">{% endif %}</a><div class="footer-links">{% if section.settings.menu != blank %}{% render 'navigation-links', menu: section.settings.menu %}{% else %}<a href="{{ section.settings.about_url | default: '/pages/about' }}">{{ section.settings.about_label | escape }}</a><a href="{{ section.settings.contact_url | default: '/pages/contact' }}">{{ section.settings.contact_label | escape }}</a>{% endif %}</div><div class="footer-socials" aria-label="Find Dillweed & Dirt">{% if section.settings.instagram_url != blank %}<a class="social-link" href="{{ section.settings.instagram_url }}" aria-label="Dillweed & Dirt on Instagram" title="Follow on Instagram"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg></a>{% endif %}{% if section.settings.etsy_url != blank %}<a class="social-link" href="{{ section.settings.etsy_url }}" aria-label="Dillweed & Dirt on Etsy" title="Shop on Etsy"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M8.559 2.445c0-.325.033-.52.59-.52h7.465c1.3 0 2.02 1.11 2.54 3.193l.42 1.666h1.27c.23-4.728.43-6.784.43-6.784s-3.196.36-5.09.36H6.635L1.521.196v1.37l1.725.326c1.21.24 1.5.496 1.6 1.606 0 0 .11 3.27.11 8.64 0 5.385-.09 8.61-.09 8.61 0 .973-.39 1.333-1.59 1.573l-1.722.33V24l5.13-.165h8.55c1.935 0 6.39.165 6.39.165.105-1.17.75-6.48.855-7.064h-1.2l-1.284 2.91c-1.005 2.28-2.476 2.445-4.11 2.445h-4.906c-1.63 0-2.415-.64-2.415-2.05V12.8s3.62 0 4.79.096c.912.064 1.463.325 1.76 1.598l.39 1.695h1.41l-.09-4.278.192-4.305h-1.391l-.45 1.89c-.283 1.244-.48 1.47-1.754 1.6-1.666.17-4.815.14-4.815.14V2.45h-.05z"/></svg></a>{% endif %}</div></div><div class="policy-links">{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div></footer>

{% schema %}
{
  "name": "Footer and social links",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu"
    },
    {
      "type": "text",
      "id": "about_label",
      "label": "About link label",
      "default": "About"
    },
    {
      "type": "url",
      "id": "about_url",
      "label": "About link destination"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact link label",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact link destination"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/dillweedanddirt/"
    },
    {
      "type": "url",
      "id": "etsy_url",
      "label": "Etsy URL",
      "default": "https://www.etsy.com/shop/DillweedandDirt"
    }
  ]
}
{% endschema %}
